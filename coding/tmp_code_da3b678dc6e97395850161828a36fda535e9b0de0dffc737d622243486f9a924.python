import pandas as pd
import os
from datetime import datetime
import pytz

# Define the path to the log file
log_file_path = './dataset/Bank/telemetry/2021_03_10/log/log_service.csv'

# Load the log data
log_data = pd.read_csv(log_file_path)

# Convert the timestamp to datetime and set timezone to Asia/Shanghai
log_data['datetime'] = pd.to_datetime(log_data['timestamp'], unit='s', utc=True)
log_data['datetime'] = log_data['datetime'].dt.tz_convert('Asia/Shanghai').dt.tz_localize(None)

# Filter logs between 15:00 and 15:30 on March 10, 2021
start_time = datetime(2021, 3, 10, 15, 0)
end_time = datetime(2021, 3, 10, 15, 30)
filtered_logs = log_data[(log_data['datetime'] >= start_time) & (log_data['datetime'] < end_time)]

# Search for error messages, warnings, or unusual patterns in the logs
error_keywords = ['error', 'fail', 'exception', 'critical', 'warn', 'unusual', 'unexpected']
filtered_logs['is_anomalous'] = filtered_logs['value'].str.contains('|'.join(error_keywords), case=False, na=False)

# Extract only the anomalous logs
anomalous_logs = filtered_logs[filtered_logs['is_anomalous']]

# Display the anomalous logs
print(anomalous_logs.to_string(index=False))

# Save the anomalous logs to a CSV file
anomalous_logs.to_csv('anomalous_logs_2021_03_10_1500_1530.csv', index=False)
