import subprocess
import sys

# Install required packages using subprocess
subprocess.check_call([sys.executable, "-m", "pip", "install", "pandas", "pytz", "--index-url", "https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple"])

import pandas as pd
from datetime import datetime
import pytz

# Load the trace_span.csv file
trace_file_path = './dataset/Bank/telemetry/2021_03_10/trace/trace_span.csv'
trace_data = pd.read_csv(trace_file_path)

# Convert timestamp from milliseconds to seconds and then to datetime
trace_data['datetime'] = pd.to_datetime(trace_data['timestamp'], unit='ms', utc=True)
trace_data['datetime'] = trace_data['datetime'].dt.tz_convert('Asia/Shanghai').dt.tz_localize(None)

# Filter data for the specified time frame: March 10, 2021, between 15:00 and 15:30
start_time = datetime(2021, 3, 10, 15, 0, 0)
end_time = datetime(2021, 3, 10, 15, 30, 0)
filtered_trace_data = trace_data[(trace_data['datetime'] >= start_time) & (trace_data['datetime'] < end_time)]

# Analyze trace durations to identify any unusually long spans
# Here, we can define a threshold for what is considered "unusually long"
# For simplicity, let's consider spans longer than 1000 ms as unusually long
unusually_long_spans = filtered_trace_data[filtered_trace_data['duration'] > 1000]

# Display the results
print(unusually_long_spans.to_string(index=False))
