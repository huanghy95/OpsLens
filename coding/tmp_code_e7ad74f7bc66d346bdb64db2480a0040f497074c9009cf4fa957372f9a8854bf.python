import pandas as pd
import numpy as np
from datetime import datetime, timedelta
import pytz

# Load the trace_span.csv file
file_path = './dataset/Bank/telemetry/2021_03_10/trace/trace_span.csv'
df_trace = pd.read_csv(file_path)

# Convert timestamp from milliseconds to seconds and then to datetime
df_trace['datetime'] = pd.to_datetime(df_trace['timestamp'], unit='ms', utc=True)
df_trace['datetime'] = df_trace['datetime'].dt.tz_convert('Asia/Shanghai').dt.tz_localize(None)

# Filter data between 15:00 and 15:30 on March 10, 2021
start_time = datetime(2021, 3, 10, 15, 0, 0)
end_time = datetime(2021, 3, 10, 15, 30, 0)
df_filtered = df_trace[(df_trace['datetime'] >= start_time) & (df_trace['datetime'] <= end_time)]

# Analyze for unusually long durations or missing spans
# Group by trace_id to analyze each trace path
anomalies = []
for trace_id, group in df_filtered.groupby('trace_id'):
    # Check for unusually long durations
    long_durations = group[group['duration'] > group['duration'].quantile(0.95)]
    if not long_durations.empty:
        anomalies.append({
            'trace_id': trace_id,
            'type': 'long_duration',
            'details': long_durations.to_dict(orient='records')
        })
    
    # Check for missing spans by looking for gaps in parent-child relationships
    parent_ids = set(group['parent_id'])
    span_ids = set(group['span_id'])
    missing_spans = parent_ids - span_ids
    if missing_spans:
        anomalies.append({
            'trace_id': trace_id,
            'type': 'missing_span',
            'details': list(missing_spans)
        })

# Print the anomalies
print("Anomalies detected:")
for anomaly in anomalies:
    print(anomaly)
