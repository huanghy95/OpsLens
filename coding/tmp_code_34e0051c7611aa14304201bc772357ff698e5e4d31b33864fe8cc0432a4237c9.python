import pandas as pd
import numpy as np
from datetime import datetime, timedelta
import pytz

# Load the metric_container.csv data
metric_container_path = './dataset/Bank/telemetry/2021_03_10/metric/metric_container.csv'
metric_container_df = pd.read_csv(metric_container_path)

# Load the metric_app.csv data
metric_app_path = './dataset/Bank/telemetry/2021_03_10/metric/metric_app.csv'
metric_app_df = pd.read_csv(metric_app_path)

# Convert timestamps to datetime objects and set timezone to Asia/Shanghai
timezone = pytz.timezone('Asia/Shanghai')
metric_container_df['datetime'] = pd.to_datetime(metric_container_df['timestamp'], unit='s', utc=True).dt.tz_convert(timezone).dt.tz_localize(None)
metric_app_df['datetime'] = pd.to_datetime(metric_app_df['timestamp'], unit='s', utc=True).dt.tz_convert(timezone).dt.tz_localize(None)

# Filter data between 15:00 and 15:30 on March 10, 2021
start_time = datetime(2021, 3, 10, 15, 0, 0)
end_time = datetime(2021, 3, 10, 15, 30, 0)
metric_container_filtered = metric_container_df[(metric_container_df['datetime'] >= start_time) & (metric_container_df['datetime'] <= end_time)]
metric_app_filtered = metric_app_df[(metric_app_df['datetime'] >= start_time) & (metric_app_df['datetime'] <= end_time)]

# Define the KPIs to be analyzed
kpis_to_analyze = [
    'OSLinux-CPU_CPU_CPUCpuUtil', 'OSLinux-CPU_CPU_CPUUserTime',
    'OSLinux-OSLinux_MEMORY_MEMORY_NoCacheMemPerc', 'OSLinux-OSLinux_MEMORY_MEMORY_MEMUsedMemPerc', 'OSLinux-OSLinux_MEMORY_MEMORY_MEMFreeMem',
    'OSLinux-OSLinux_NETWORK_NETWORK_TCP-FIN-WAIT', 'OSLinux-OSLinux_NETWORK_NETWORK_TotalTcpConnNum',
    'OSLinux-OSLinux_LOCALDISK_LOCALDISK-sdb_DSKReadWrite',
    'OSLinux-OSLinux_FILESYSTEM_-tomcat_FSCapacity', 'OSLinux-OSLinux_FILESYSTEM_-apache_FSCapacity',
    'JVM-Operating System_7779_JVM_JVM_CPULoad', 'JVM-Operating System_7778_JVM_JVM_CPULoad',
    'JVM-Memory_7778_JVM_Memory_NoHeapMemoryUsed', 'JVM-Memory_7779_JVM_Memory_NoHeapMemoryUsed'
]

# Filter the metric_container data for the KPIs to be analyzed
metric_container_filtered = metric_container_filtered[metric_container_filtered['kpi_name'].isin(kpis_to_analyze)]

# Normalize the values for each KPI
anomaly_events = []

for kpi in kpis_to_analyze:
    kpi_data = metric_container_filtered[metric_container_filtered['kpi_name'] == kpi]
    
    # Extend the time window by 15 minutes before and after
    extended_start_time = start_time - timedelta(minutes=15)
    extended_end_time = end_time + timedelta(minutes=15)
    extended_kpi_data = metric_container_df[(metric_container_df['kpi_name'] == kpi) & 
                                            (metric_container_df['datetime'] >= extended_start_time) & 
                                            (metric_container_df['datetime'] <= extended_end_time)]
    
    # Normalize the values
    min_value = extended_kpi_data['value'].min()
    max_value = extended_kpi_data['value'].max()
    extended_kpi_data['normalized_value'] = (extended_kpi_data['value'] - min_value) / (max_value - min_value) * 100
    
    # Analyze each component for anomalies
    for cmdb_id in extended_kpi_data['cmdb_id'].unique():
        component_data = extended_kpi_data[extended_kpi_data['cmdb_id'] == cmdb_id]
        component_data = component_data.sort_values(by='datetime')
        
        # Detect anomalies
        stable_threshold = 5
        anomaly_threshold = 1
        recovery_threshold = 5
        
        values = component_data['normalized_value'].values
        times = component_data['datetime'].values
        
        for i in range(len(values) - stable_threshold - anomaly_threshold - recovery_threshold):
            stable_phase = values[i:i+stable_threshold]
            anomaly_phase = values[i+stable_threshold:i+stable_threshold+anomaly_threshold]
            recovery_phase = values[i+stable_threshold+anomaly_threshold:i+stable_threshold+anomaly_threshold+recovery_threshold]
            
            if (np.std(stable_phase) < 5 and
                np.max(anomaly_phase) > np.mean(stable_phase) + 10 and
                np.std(recovery_phase) < 5):
                
                anomaly_start_time = times[i+stable_threshold]
                delta = np.max(anomaly_phase) - np.mean(stable_phase)
                
                anomaly_event = {
                    'data_source': "Metric",
                    'timestamp': anomaly_start_time.strftime('%Y-%m-%d %H:%M:%S'),
                    'cmdb_id': cmdb_id,
                    'description': f"{kpi} is abnormally high, delta={delta:.2f}"
                }
                anomaly_events.append(anomaly_event)
                break

# Sort anomalies by delta value in descending order
anomaly_events = sorted(anomaly_events, key=lambda x: x['description'].split('=')[-1], reverse=True)

# Print and save the results
anomaly_df = pd.DataFrame(anomaly_events)
print(anomaly_df.to_string(index=False))
anomaly_df.to_csv('anomaly_events.csv', index=False)
